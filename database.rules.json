{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "slots": {
          "$slot": {
            ".write": "auth != null && (newData.val() === auth.uid || data.val() === auth.uid)"
          }
        },
        "view": {
          ".write": "auth != null && root.child('rooms').child($room).child('host').val() === auth.uid"
        }
      }
    }
  }
}
